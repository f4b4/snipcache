{
  "name": "snipcache",
  "version": "0.0.0",
  "private": true,
  "description": "SnipCache monorepo: static site builder, reusable workflow and editor.",
  "scripts": {
    "build": "pnpm --recursive --filter \"./site\" --filter \"./frontend/**\" build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
