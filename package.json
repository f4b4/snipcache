{
  "name": "snipcache",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SnipCache monorepo: static site builder, reusable workflow and editor.",
  "scripts": {
    "build": "pnpm --recursive --filter \"./site\" --filter \"./frontend/**\" build",
    "dev": "pnpm --filter editor dev",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vitest": "^4.1.8"
  }
}
