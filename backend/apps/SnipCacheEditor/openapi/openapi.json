        "required": [
          "path",
          "type",
          "size"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/NodeType"
          },
          "size": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          }
        }
      },
      "TreeResponse": {
        "required": [
