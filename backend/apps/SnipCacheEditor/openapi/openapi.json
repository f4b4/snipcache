        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "commitSha": {
            "type": "string"
          },
          "commitUrl": {
            "type": "string"
          }
        }
      },
      "SaveSnippetRequest": {
        "required": [
          "fileName",
          "content"
        ],
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "folder": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "SaveSnippetResponse": {
        "required": [
          "path",
          "sha",
          "commitUrl",
          "pageUrl"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "commitUrl": {
            "type": "string"
          },
          "pageUrl": {
            "type": "string"
          }
        }
      },
