        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "sha": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SaveFileResponse": {
        "required": [
          "path",
