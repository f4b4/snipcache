# /etc/snipcache/secrets.env — read by systemd (EnvironmentFile=), never committed
# with values. setup.sh installs this template once (root:snipcache, mode 600) and
# never overwrites it. Fill in the values, then: sudo systemctl restart snipcache
#
# Fine-grained PAT: resource owner f4b4, repository access snipcache-content-f4b4
# only, permission Contents: Read and write.
GitHub__Token=
# Optional: the PAT's expiry date (yyyy-MM-dd); the editor logs a warning 14 days ahead.
# GitHub__TokenExpires=
# Bot API key, 32+ characters: openssl rand -base64 32
Bot__ApiKey=
